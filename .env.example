# Copy to .env.local and fill in. Never commit real values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
MOYASAR_SECRET_KEY=
MOYASAR_WEBHOOK_SECRET=
# E-mail (reminders, booking mails, "send me my link"). Demo tenants (is_demo) ALWAYS use the demo mailbox
# (/[locale]/demo/mailbox) whatever is set here: no real mail is ever sent for demo data.
#   MAIL_PROVIDER=resend  -> real tenants send through Resend (needs RESEND_API_KEY)
#   MAIL_PROVIDER=outbox / unset -> real tenants cannot send (reminders are retried, then marked failed)
# Resend FREE plan: 100 mails/day, 3000/month. Without a VERIFIED DOMAIN Resend only delivers to the
# account owner's own address (403 otherwise), so real tenants need a verified domain and a MAIL_FROM on it
# (default sender onboarding@resend.dev is Resend's test sender, owner-address only).
MAIL_PROVIDER=outbox
RESEND_API_KEY=
MAIL_FROM=
# Bearer secret for /api/cron/reminders (GitHub Action + Vercel cron). Min 16 chars; unset = endpoint always 401.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Demo sign-in page and demo payments are OFF unless DEMO_MODE is exactly "true".
# The hosted demo is PER VISITOR: each click on /demo creates a temporary auth user through the Auth Admin API
# (random e-mail on demo.dawrak.invalid, random 32-byte password that exists only inside that request) and
# registers it with register_demo_user(). There is no shared demo login and NO demo password setting; the
# hosted deployment needs only DEMO_MODE=true and SUPABASE_SERVICE_ROLE_KEY. Visitors expire after 24 h.
DEMO_MODE=true
GEMINI_MODEL=

# Local e2e ONLY (never set on a hosted deployment): the six fixed seeded demo users from supabase/seed.sql
# (clinic-owner@, clinic-reception@, clinic-doctor@, salon-owner@ ... example.com) sign in with this password
# in the Playwright specs that need the provider role. On a hosted project reset_demo() gives those users
# random passwords, so this value would not work there anyway. The app itself never reads it.
DEMO_PASSWORD=Demo#2026

# Client IP for rate limiting. On Vercel the platform headers are trusted automatically. Anywhere else every
# forwarded header is client-controlled, so by default ALL clients share ONE rate-limit bucket ("unknown") and
# the server logs a one-time warning in production. If (and only if) your own reverse proxy sets or appends a
# header, name it here, e.g. x-forwarded-for (nginx, most load balancers) or cf-connecting-ip (Cloudflare).
# Rule: the RIGHT-MOST entry is used (the one your proxy added); correct for exactly one trusted proxy hop,
# and the proxy must overwrite/append the header rather than pass a client-supplied one through unchanged.
TRUSTED_PROXY_HEADER=

# Payments (src/lib/payments). PAYMENT_PROVIDER=moyasar|fake.
# Unset = moyasar when MOYASAR_SECRET_KEY is set, otherwise payments are unavailable. The fake provider
# is NEVER chosen implicitly (DEMO_MODE does not select it): set PAYMENT_PROVIDER=fake on purpose.
# fake: no network, only for tenants with is_demo = true, refused on a Vercel production deployment,
# and refused in any other production build unless ALLOW_FAKE_PAYMENTS=true. Its webhook is disabled
# (401) until FAKE_WEBHOOK_SECRET is set; there is no default secret.
# Moyasar TEST mode: sk_test_... key; MOYASAR_WEBHOOK_SECRET is any long random string you also
# enter as the Secret Token when adding the webhook (endpoint: <site>/api/webhooks/moyasar).
# A production deployment without MOYASAR_SECRET_KEY refuses to start a payment.
PAYMENT_PROVIDER=
ALLOW_FAKE_PAYMENTS=
FAKE_WEBHOOK_SECRET=
